# Copy to .env and fill in. Real environment variables override this file.

# Which adapter to use: "openai" or "anthropic". Switching needs no code change.
MINICODE_PROVIDER=openai

# Main model (agent) and small model (summaries, routing). Model IDs change often:
# check the provider's current model list before relying on these.
#   OpenAI:    https://developers.openai.com/api/docs/models   (e.g. gpt-6.1-sol / gpt-6-luna)
#   Anthropic: https://platform.claude.com/docs/en/about-claude/models  (e.g. claude-sonnet-5-5 / claude-haiku-5-5)
MINICODE_MODEL=gpt-6.1-sol
MINICODE_SMALL_MODEL=gpt-6-luna

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
